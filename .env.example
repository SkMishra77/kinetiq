# Copy to `.env` and edit. `.env` is gitignored.
# `chmod 600 .env` before deploying — this file holds a URL token.

# Required ------------------------------------------------------------------

# 48+ url-safe chars. Generate with:  uv run kinetiq gen-token
KINETIQ_MCP_PATH_TOKEN=REPLACE_ME_WITH_48_CHAR_TOKEN

# Public hostname served by Caddy. For DuckDNS: <your-subdomain>.duckdns.org.
# You create the subdomain at https://www.duckdns.org and point it at this box.
KINETIQ_DOMAIN=your-subdomain.duckdns.org

# DuckDNS updater ---------------------------------------------------------
# Bare subdomain (no `.duckdns.org` suffix) and the token from the top of
# your DuckDNS account page.
DUCKDNS_SUBDOMAIN=your-subdomain
DUCKDNS_TOKEN=your-duckdns-token

# ACME account email for Let's Encrypt certificate registration.
KINETIQ_ACME_EMAIL=you@example.com

# Optional ----------------------------------------------------------------
KINETIQ_TIMEZONE=Asia/Kolkata
KINETIQ_LOG_LEVEL=INFO
KINETIQ_RATE_LIMIT_RPS=10

# Research API keys (higher rate limits, optional):
# NCBI_API_KEY=...
# S2_API_KEY=...
# OPENALEX_MAILTO=you@example.com

# For ngrok compose profile only:
# NGROK_AUTHTOKEN=...
# COMPOSE_PROFILES=ngrok
